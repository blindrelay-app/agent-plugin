{
  "mcpServers": {
    "blindrelay-with-oauth": {
      "type": "streamable-http",
      "url": "https://api.blindrelay.app/mcp"
    },
    "blindrelay-with-api-key": {
      "type": "streamable-http",
      "url": "https://api-pat.blindrelay.app/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.BLINDRELAY_API_KEY}"
      }
    }
  }
}
